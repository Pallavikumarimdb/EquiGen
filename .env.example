# Groq API Key for Llama 3.3 70B extraction
# Get your key from: https://console.groq.com
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# For Fall back Freemium AI
OPENROUTER_API_KEY=
# (Optional) Groq Vision model for chart/image-heavy PDF pages.
# Defaults to llama-3.2-11b-vision-preview if not set.
# Check current available vision models at https://console.groq.com/docs/models
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# AES-256-GCM encryption key for BYOK API keys stored in the database
# Generate with: openssl rand -hex 16  (must be exactly 32 characters)
ENCRYPTION_KEY=your_32_char_random_secret_here

# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/equigen

# (Optional) API Secret for protecting sensitive routes (approve, settings, history delete).
# When set, external callers must pass the matching x-api-secret header.
# Same-origin browser requests (dashboard UI) are always permitted.
# Leave empty to disable auth (local dev only).
API_SECRET=

# Internal service credential for headless callers: the autonomous agent runner,
# CI smoke tests and Playwright. Presented as the x-api-secret header; it grants a
# PLATFORM-OPERATOR identity which may read across tenants (legacy orgId:null rows
# included). Ordinary users never get this.
# REQUIRED whenever a headless caller talks to the API — there is no default value.
#   openssl rand -hex 24
INTERNAL_API_SECRET=

# ─── Market data freshness ────────────────────────────────────────────────────
# NSE/BSE exchange holidays as IST `YYYY-MM-DD` dates, comma or newline separated.
# Market-data freshness is measured in elapsed TRADING SESSIONS, not wall-clock
# hours: a price read Friday 18:00 IST is still current on Monday morning, and a
# Tuesday-morning read is stale by Wednesday afternoon even though both are under
# 24 hours apart.
#
# When this is empty, weekends are excluded but exchange holidays are NOT, so a
# Diwali week may be reported as fresh when it is not. Populate it from the NSE
# trading-holiday calendar (revised annually) to keep freshness honest.
#   https://www.nseindia.com/market-data/securities-available-for-trading
NSE_HOLIDAYS=

# ─── Billing (Dodo Payments) ──────────────────────────────────────────────────
# Dodo is a Merchant of Record, so it handles sales tax/GST, invoicing, and
# remittance — which is why you can sell without a registered company.
#
# Leave DODO_PAYMENTS_API_KEY empty to run without payments: pricing cards stay
# visible, checkout returns 503, and every org falls back to the Free plan.
# Keys: https://dashboard.dodopayments.com/developer/api-keys
DODO_PAYMENTS_API_KEY=

# Signing secret from Developer -> Webhooks. Point an endpoint at
# POST https://<your-domain>/api/billing/webhook and subscribe to:
#   subscription.active, subscription.updated, subscription.renewed,
#   subscription.past_due, subscription.on_hold, subscription.paused,
#   subscription.unpaused, subscription.plan_changed,
#   subscription.cancelled, subscription.expired, subscription.failed
DODO_PAYMENTS_WEBHOOK_KEY=

# "test_mode" (default) or "live_mode". Anything unrecognised falls back to test.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Fixed billing currency. Dodo infers currency from the customer's IP and then
# freezes it for the subscription's lifetime, so pin it deliberately.
DODO_BILLING_CURRENCY=INR

# Dodo product_ids per tier and billing cycle, created under Products.
# IMPORTANT: on each product set a Subscription Period much LONGER than the
# Payment Frequency (e.g. period 20 years / frequency 1 month). Equal values make
# a subscription expire after a single cycle instead of recurring.
# The amount configured on the Dodo product is what the customer is charged; the
# prices in src/lib/billing/plans.ts are display-only and must match.
# A missing product id makes that tier/cycle report "product_not_mapped".
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_DESK_MONTHLY=
DODO_PRODUCT_DESK_YEARLY=
