{
  "name": "equigen-equity-research",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:deps": "pnpm audit --audit-level high",
    "audit:secrets": "node scripts/scan-committed-secrets.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "spike:table": "tsx scripts/table-extraction-spike.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.6",
    "@napi-rs/canvas": "^1.0.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sparticuz/chromium": "^149.0.0",
    "@types/exceljs": "^1.3.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "groq-sdk": "^0.9.0",
    "iconv-lite": "^0.7.3",
    "jose": "^6.2.10",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "papaparse": "^5.5.4",
    "pdfkit": "^0.15.0",
    "pg": "^8.22.0",
    "puppeteer": "^25.5.0",
    "puppeteer-core": "^25.6.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.5",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.14.9",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.20.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "eslint": "^9.19.0",
    "eslint-config-next": "15.5.27",
    "playwright": "^1.63.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "prisma": "^7.9.1",
    "skia-canvas": "^3.0.8",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.11",
    "typescript": "^5.5.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "skia-canvas"
    ],
    "ignoredBuiltDependencies": [
      "puppeteer",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "next": "15.5.27",
      "sharp": ">=0.35.5",
      "postcss": ">=8.5.23",
      "fast-uri": ">=3.1.8",
      "mysql2": ">=3.23.1",
      "deepmerge-ts": ">=8.0.0",
      "brace-expansion": "5.0.12",
      "source-map-js": ">=1.2.2",
      "nanoid": ">=3.3.18",
      "uuid": ">=11.1.1",
      "js-yaml": ">=4.3.2",
      "postcss-selector-parser": ">=7.1.6"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93687"
      ]
    }
  }
}
