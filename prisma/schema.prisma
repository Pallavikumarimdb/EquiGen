// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id             String          @id @default(uuid())
  name           String
  logoUrl        String?         // Custom branding logo for PDFs/Excel
  primaryColor   String          @default("#0f172a") // Branding primary color (default Tailwind Slate-900)
  accentColor    String          @default("#10b981") // Branding accent color (default Tailwind Emerald-500)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  // Relations
  users          User[]
  apiKeys        ApiKey[]
  reports        ReportHistory[]
  jobs           ExtractionJob[]
  documents      Document[]
  sessions       ResearchSession[]
  notifications  Notification[]
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  name           String
  role           String          @default("analyst") // "admin" | "analyst" | "reviewer"
  sebiRegNo      String?         // Only applicable for "reviewer" role
  orgId          String
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  // Relations
  userSessions   UserSession[]
  auditLogs      AuditLog[]
  proposals      CorrectionProposal[]
  createdReports ReportHistory[]  @relation("CreatedReports")
  reviewedReports ReportHistory[] @relation("ReviewedReports")
  extractionJobs ExtractionJob[]
  notifications  Notification[]

  @@index([orgId])
}

model UserSession {
  id             String          @id @default(uuid())
  userId         String
  token          String          @unique
  expiresAt      DateTime
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())

  @@index([userId])
}

model ReportHistory {
  id                    String    @id
  orgId                 String?
  org                   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyName           String
  fileName              String
  reportData            Json
  pdfBase64             String?
  status                String    @default("draft") // "draft" | "pending_review" | "under_review" | "changes_requested" | "approved" | "published"
  
  // Compliance and reviews
  createdById           String?
  createdBy             User?        @relation("CreatedReports", fields: [createdById], references: [id], onDelete: SetNull)
  reviewerId            String?
  reviewer              User?        @relation("ReviewedReports", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerName          String?
  sebiRegNo             String?
  approvedAt            DateTime?
  approvedByIp          String?
  contentHash           String?
  versionNo             Int       @default(1)
  modelUsedForFinancials String?
  dataQuality           String    @default("ok")
  assignedReviewerId    String?
  assignedReviewerName  String?
  createdAt             DateTime  @default(now())

  @@index([orgId])
}

model ExtractionJob {
  id                String   @id
  orgId             String?
  org               Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdById       String?
  createdBy         User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  companyName       String
  fileName          String
  rawText           String
  status            String   @default("running") // "running", "failed", "throttled", "completed", "blocked_financials"
  stepIndex         Int      @default(0)          // 0: preprocessor, 1: general, 2: swot, 3: financials
  condensedContext  String?
  companyGeneral    Json?
  swotAndThesis     Json?
  financials        Json?
  mathErrors        Json?
  errorMessage      String?
  retryAfterSeconds Int?                          // set on throttled status — seconds to wait before auto-resume
  /** Human-readable reason while the job is paused internally (e.g. waiting for AI token budget) */
  waitMessage       String?
  /** Absolute time when the internal wait ends — lets the client show a live countdown */
  waitUntil         DateTime?
  /** ID of the ReportHistory record created after successful completion */
  reportId          String?
  /** ID of the parsed source Document; null for pre-document-pipeline uploads */
  documentId        String?
  /** inputHash was computed with this PROMPT_VERSIONS snapshot — bumping versions invalidates ok chunks */
  schemaVersion     String?
  /** Verdict from the section detector: "ok" | "ocr_recheck" | "full_document" */
  targetingVerdict  String?
  /** Number of chunks that ended degraded/failed (drives dataQuality + reviewer flow) */
  degradedChunks    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orgId])
}

/** A parsed source document — one row per uploaded file, with per-page records below. */
model Document {
  id               String        @id @default(uuid())
  orgId            String?
  org              Organization?  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  storageKey       String
  fileName         String
  sha256           String?
  totalPages       Int           @default(0)
  status           String        @default("parsing") // "parsing" | "parsed" | "failed"
  /** SectionMap + confidence from the section detector */
  targetingJson    Json?
  /** "ok" | "ocr_recheck" | "full_document" | "blocked" */
  targetingVerdict String?
  createdAt        DateTime      @default(now())
  pages            DocumentPage[]
  tables           DocumentTable[]

  @@index([orgId])
}

/** Per-page record: native text, OCR text, raw table structures, targeting annotations. */
model DocumentPage {
  id          String         @id @default(uuid())
  documentId  String
  pageNo      Int
  nativeText  String?
  ocrText     String?
  hasTables   Boolean        @default(false)
  isScanned   Boolean        @default(false)
  charCount   Int            @default(0)
  /** Target classes assigned by the section detector, e.g. { financials: true, narrative: true } */
  annotations Json?
  createdAt   DateTime       @default(now())
  document    Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tables      DocumentTable[]

  @@unique([documentId, pageNo])
  @@index([documentId])
}

/** Raw extracted table structure (literal record of the PDF) + separate normalized output. */
model DocumentTable {
  id             String       @id @default(uuid())
  documentId     String
  pageNo         Int
  tableNo        Int          @default(1)
  /** "layout" (native text heuristics) | "vision" (LLM on rendered page) | "ocr" (tesseract) */
  detectedBy     String       @default("layout")
  /** Raw rows/columns as extracted — source of truth for what the PDF literally says */
  rawJson        Json?
  /** Model-normalized schema output — kept separate so extraction bugs vs normalization bugs are diagnosable */
  normalizedJson Json?
  /** Fraction of numeric cells that passed Indian-format validation (0..1) */
  quality        Float?
  status         String       @default("ok") // "ok" | "degraded" | "failed"
  error          String?
  modelUsed      String?
  createdAt      DateTime     @default(now())
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page           DocumentPage @relation(fields: [pageNo, documentId], references: [pageNo, documentId], onDelete: Cascade)

  @@unique([documentId, pageNo, tableNo])
  @@index([documentId])
}

/** Per-chunk extraction state — granular idempotent retries/resume instead of whole-step checkpoints. */
model ChunkExtraction {
  id             String   @id @default(uuid())
  jobId          String
  /** Page number or section key this chunk covers */
  chunkKey       String
  /** "narrative" | "financials" | "swot" | "general" */
  extractType    String
  /** sha256(chunkText + extractType + promptVersion[extractType]) — schema/prompt bumps invalidate "ok" chunks */
  inputHash      String
  extractionJson Json?
  /** Per-value page provenance, e.g. [{ value: "...", page: 87 }] */
  citePages      Json?
  status         String   @default("pending") // "pending" | "ok" | "degraded" | "failed"
  retries        Int      @default(0)
  error          String?
  latencyMs      Int?
  modelUsed      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([jobId, chunkKey, extractType])
  @@index([jobId, status])
}

/**
 * Shared per-minute token usage (Postgres-backed token bucket).
 * Backend for TokenBudgetStore — swap for Redis (INCR/EXPIRE) via the store interface without touching callers.
 */
model TokenBudgetUsage {
  model     String
  /** UTC minute key "yyyy-MM-ddTHH:mm" — window reads sum the last 60s of buckets */
  minuteKey String
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([model, minuteKey])
  @@index([model])
}

/** Model rate-limit registry — configured defaults overridden by live x-ratelimit-* header discovery. */
model ModelLimit {
  model             String   @id
  tpm               Int      @default(6000)
  tpd               Int      @default(1000000)
  /** "configured" | "discovered" | "env" */
  source            String   @default("configured")
  lastDiscoveredAt  DateTime?
  updatedAt         DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId  String?
  jobId     String?
  /** "pending_review" | "blocked_financials" | "degraded" | "budget_warning" */
  type      String
  message   String
  payload   Json?
  status    String   @default("unread") // "unread" | "read" | "resolved"
  createdAt DateTime @default(now())
}

model ApiKey {
  id           String   @id @default(uuid())
  orgId        String?  @default("default-org")
  org          Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider     String   // "groq" | "openai"
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orgId, provider])
}

model AuditLog {
  id        String   @id @default(uuid())
  reportId  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorType String   @default("human") // "human" | "agent" | "system"
  action    String   // "state_change" | "sign_off" | "field_correction_proposed" | "field_correction_approved" | "field_correction_rejected" | "tool_call" | "recompute"
  fromState String?
  toState   String?
  metadata  Json     // Includes details like hash, ip, status changes, diffs
  createdAt DateTime @default(now())
}

model CorrectionProposal {
  id          String   @id @default(uuid())
  reportId    String
  sessionId   String?  // Optional link to conversation session
  field       String   // e.g. "financials.revenue.FY24" or "companyGeneral.companyName"
  oldValue    Json?
  newValue    Json?
  reasoning   String?
  origin      String   // "math_auditor" | "agent_tool" | "live_data_refresh"
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  reviewedBy  String?
  reviewer    User?    @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
}

model ResearchSession {
  id        String   @id @default(uuid())
  reportId  String
  orgId     String?  @default("default-org")
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy String   @default("analyst")
  createdAt DateTime @default(now())
  messages  ConversationMessage[]
  toolCalls ToolCall[]
  researchPlans ResearchPlan[]

  @@index([orgId])
}


model ConversationMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String   // "user" | "agent"
  content   String
  createdAt DateTime @default(now())
  session   ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ToolCall {
  id           String   @id @default(uuid())
  sessionId    String
  toolName     String
  inputJson    Json
  outputJson   Json
  latencyMs    Int
  costEstimate Float    @default(0.0)
  status       String   // "success" | "failed"
  createdAt    DateTime @default(now())
  session      ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model GoldenExample {
  id              String   @id @default(uuid())
  companyName     String
  sourceDocRef    String
  groundTruthJson Json
  difficultyTag   String   @default("medium") // "easy" | "medium" | "hard" | "edge_case"
  createdAt       DateTime @default(now())
}

// ─── plan4.md: Autonomous AI Analyst Models ──────────────────────────────────

model ResearchPlan {
  id             String          @id @default(uuid())
  sessionId      String
  goalText       String
  /** Primary company ticker e.g. "TATAMOTORS" — used by the orchestrator to route agents */
  ticker         String?
  /** Display name of the company e.g. "Tata Motors Limited" */
  companyName    String?
  milestones     Json            // MilestonePlan[]
  depth          String          @default("standard") // "quick" | "standard" | "deep"
  costEstimate   Float?          // USD
  latencyEstS    Int?            // seconds
  status         String          @default("pending") // pending|approved|running|completed|failed|cancelled
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime        @default(now())
  session        ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subagentRuns   SubagentRun[]
  steeringEvents SteeringEvent[]
}

model SubagentRun {
  id              String           @id @default(uuid())
  planId          String
  agentType       String           // "document" | "modeling" | "market_intel" | "compliance" | "synthesis"
  milestoneRef    String?
  status          String           @default("running") // running|completed|failed
  inputJson       Json?
  outputJson      Json?
  latencyMs       Int?
  costUsd         Float?
  createdAt       DateTime         @default(now())
  plan            ResearchPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  sandboxArtifacts SandboxArtifact[]
  scrapeJobs      ScrapeJob[]
}

model SandboxArtifact {
  id           String      @id @default(uuid())
  runId        String
  artifactType String      // "python_script" | "chart_png" | "csv" | "json" | "compliance_report_json"
  storageUrl   String?
  codeText     String?
  stdout       String?
  stderr       String?
  exitCode     Int?
  createdAt    DateTime    @default(now())
  run          SubagentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ScrapeJob {
  id            String      @id @default(uuid())
  runId         String
  url           String
  sourceType    String?     // "bse_filing" | "nse_filing" | "screener" | "concall_transcript" | "drhp"
  rawHtmlUrl    String?
  extractedText String?
  status        String      @default("queued") // queued|running|completed|failed
  createdAt     DateTime    @default(now())
  run           SubagentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model SteeringEvent {
  id        String       @id @default(uuid())
  planId    String
  actorId   String?
  eventType String       // "pause" | "resume" | "redirect" | "cancel" | "approve_milestone" | "skip_milestone"
  payload   Json?
  createdAt DateTime     @default(now())
  plan      ResearchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

