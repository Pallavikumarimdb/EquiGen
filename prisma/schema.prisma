// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ReportHistory {
  id           String   @id
  companyName  String
  fileName     String
  reportData   Json
  pdfBase64    String?
  createdAt    DateTime @default(now())
}
